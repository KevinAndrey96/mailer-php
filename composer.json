{
    "name": "kevinandrey96/php-smtp-mailer-api",
    "description": "Secure transactional email JSON API in PHP 8.4+ over SMTP with PHPMailer: bearer token authentication, recipient allowlist, verified TLS, CORS, Docker and Mailpit.",
    "type": "project",
    "license": "MIT",
    "keywords": ["php", "smtp", "phpmailer", "email", "transactional-email", "json-api", "docker", "mailpit"],
    "authors": [
        {
            "name": "Kevin Andrey Herrera Silva",
            "email": "kahs_kevin@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "SmtpMailer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmtpMailer\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": ["@analyse", "@test"]
    }
}
