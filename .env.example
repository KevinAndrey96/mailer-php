# Copy to .env and replace the placeholders. .env is git-ignored.
# Generate a token with: openssl rand -hex 32
API_TOKEN=replace-with-a-random-token-of-at-least-32-characters
APP_PORT=8080
MAILPIT_UI_PORT=8025

# Local development delivers to Mailpit. For a real server use e.g.
# SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_ENCRYPTION=tls SMTP_USERNAME=... SMTP_PASSWORD=...
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=SMTP Mailer API

# Comma separated. Use * only if any recipient domain is acceptable.
ALLOWED_RECIPIENT_DOMAINS=example.com
MAX_RECIPIENTS=10
# Comma separated browser origins allowed to call the API (CORS). Empty disables CORS.
ALLOWED_ORIGINS=
